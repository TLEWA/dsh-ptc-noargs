{
  "$schema": "https://raw.githubusercontent.com/TLEWA/dsh-plugin-ci/v1/schema/ci.config.schema.json",
  "version": 1,
  "build": null,
  "typecheck": null,
  "test": "node test/prelude.test.mjs",
  "testGlobs": [
    "test/**/*.test.mjs"
  ],
  "manifest": {
    "manifestVersion": 1,
    "requireEnginesNode": true,
    "allowedInject": [
      "@deepseek-ai/*"
    ]
  },
  "docs": {
    "pairs": [
      [
        "README.md",
        "README.en.md"
      ],
      [
        "CHANGELOG.md",
        "CHANGELOG.en.md"
      ]
    ],
    "required": [
      "README.md",
      "README.en.md",
      "CHANGELOG.md",
      "CHANGELOG.en.md",
      "LICENSE",
      "AGENTS.md",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/workflows/ci.yml",
      ".github/workflows/drift.yml",
      ".github/workflows/release.yml"
    ],
    "published": [
      "README.md",
      "README.en.md",
      "CHANGELOG.md",
      "CHANGELOG.en.md",
      "LICENSE"
    ]
  },
  "tarball": {
    "mustInclude": [
      "lib/index.js",
      "lib/prelude.js",
      "cordis.patch.yml",
      "README.md",
      "README.en.md",
      "CHANGELOG.md",
      "CHANGELOG.en.md",
      "LICENSE"
    ],
    "mustExclude": [
      "test/**",
      ".github/**",
      ".ci/**",
      "*.tgz",
      "node_modules/**"
    ],
    "maxBytes": 2097152
  },
  "release": {
    "publish": true,
    "provenance": true
  },
  "guards": {
    "requireHumanApprovedLabel": true
  }
}
